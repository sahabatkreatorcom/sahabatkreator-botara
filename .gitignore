# Dependensi
node_modules/
.pnpm-store/

# Hasil build
dist/
build/
*.tsbuildinfo

# Rahasia — JANGAN pernah commit
.env
.env.*
!.env.example
*.pem
*.key

# Log & artefak runtime
*.log
# PERHATIAN: harus berakar ("/logs/"), bukan "logs/". Pola tanpa akar
# mencocokkan direktori bernama `logs` DI KEDALAMAN MANA PUN — termasuk
# direktori SUMBER `apps/api/src/modules/logs/`. Itu pernah membuat dua
# berkas sumber tidak ikut ter-commit dan build Docker gagal dengan
# "Could not resolve ./modules/logs/routes" padahal typecheck lokal lulus.
/logs/
coverage/
.nyc_output/
# Direktori temp Vitest (lihat vitest.config.ts: sengaja di root repo,
# bukan di node_modules atau %TEMP%, agar tulis cache tidak diblokir
# sandbox yang membatasi kedua lokasi itu).
.tmp-vitest/

# Berkas OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Database lokal & dump
*.sqlite
*.db
*.sql.gz

# Data proyek milik agen (catatan kerja, cache) — bukan sumber.
.workbuddy-ai/
